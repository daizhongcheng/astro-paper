---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Hero from "@/components/Hero.astro";
import Overview from "@/components/Overview.astro";
import ProductCards from "@/components/ProductCards.astro";
import TechStack from "@/components/TechStack.astro";
import GitHubCta from "@/components/GitHubCta.astro";
import About from "@/components/About.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const { landing } = config;
---

<Layout
  title={`${landing.brand} — Physics-First AI | ${landing.heroTitle}`}
  description="Physics-first AI company. DYNPHI encodes deterministic physical equations into models to eliminate physics hallucination at the source."
>
  <Navbar />
  <main id="main" class="flex-1">
    <Hero />
    <Overview />
    <ProductCards />
    <TechStack />
    <GitHubCta />
    <About />
  </main>
  <Footer />
</Layout>