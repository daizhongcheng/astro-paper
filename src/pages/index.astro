---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Hero from "@/components/Hero.astro";
import WhyBento from "@/components/WhyBento.astro";
import WhatDX from "@/components/WhatDX.astro";
import HowPipeline from "@/components/HowPipeline.astro";
import About from "@/components/About.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const { landing } = config;
---

<Layout
  title={`${landing.brand} — Compile Physical Laws. Sustain Intelligent Agents.`}
  description="DYNPHI is a compiler layer for AI — compiling the laws of physics directly into intelligent agents."
>
  <Navbar />
  <main id="main" class="flex-1">
    <Hero />
    <WhyBento />
    <WhatDX />
    <HowPipeline />
    <About />
  </main>
  <Footer />

  <script>
    import { initI18n } from "@/utils/i18n";

    // Simple document-title / description swap on language change.
    const seo = {
      en: {
        title: `DYNPHI — Compile Physical Laws. Sustain Intelligent Agents.`,
        desc: "DYNPHI is a compiler layer for AI — compiling the laws of physics directly into intelligent agents.",
      },
      zh: {
        title: "DYNPHI — 编译物理律，承载智能体",
        desc: "DYNPHI 是连接符号推理与物理现实的编译层基础设施——以编译器级精度，把物理定律直接编译进智能体。",
      },
    };

    new MutationObserver(() => {
      const lang = document.documentElement.dataset.lang === "zh" ? "zh" : "en";
      document.title = seo[lang].title;
      const m = document.querySelector('meta[name="description"]');
      if (m) m.setAttribute("content", seo[lang].desc);
      const og = document.querySelector('meta[property="og:description"]');
      if (og) og.setAttribute("content", seo[lang].desc);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });

    initI18n();
  </script>
</Layout>