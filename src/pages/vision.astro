---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";

interface Chapter {
  no: string;
  title: { en: string; zh: string };
  slogan: { en: string; zh: string };
  body: { en: string[]; zh: string[] };
  points: { en: string[]; zh: string[] };
}

/** Vision-page copy. Kept local (not in global config) so this standalone
 *  white-paper module stays independently evolvable. All nodes are localised
 *  via the existing `data-i18n` client mechanism. */
const vision = {
  eyebrow: { en: "TECHNICAL VISION", zh: "技术愿景" },
  title: { en: "From Compiler to Embodied Intelligence", zh: "从编译器，到具身智能" },
  tagline: {
    en: "Compile the laws. Update the weights. Move any body.",
    zh: "编译定律，动态权重，驾驭万体。",
  },
  intro: {
    en: [
      "DYNPHI begins as a compiler: turning physical laws into hard constraints inside the model. But the story does not end at design time. To act in the physical world, a model must understand its own body, close the loop with what actually happened, and stretch one intelligence across every mechanical form.",
      "Three ideas carry that extension — an AI-native hardware abstraction, a closed-loop world model, and run-time adaptive weights.",
    ],
    zh: [
      "DYNPHI 起步于一台编译器：把物理定律变成模型内部的硬约束。但故事并不止于设计期。要真正在物理世界行动，模型必须理解自己的身体、与世界实际发生的结果闭环、把同一份智能扩展到每一种机械形态。",
      "三大思想承载这一延伸——AI 原生的硬件抽象、闭环世界模型，以及运行期自适应权重。",
    ],
  },
  archTitle: { en: "The Architecture at a Glance", zh: "总体架构一瞥" },
  archLegend: {
    en: "Design-time compiles the laws in; run-time adapts one brain to any body.",
    zh: "设计期把定律编译进来，运行期让同一大脑适配任意躯体。",
  },
  chapters: [
    {
      no: "01",
      title: { en: "The AI-Native HAL", zh: "面向 AI 原生的硬件抽象层" },
      slogan: { en: "One tensor contract for every actuator", zh: "一张张量契约，接管所有执行器" },
      body: {
        en: [
          "Servo, VFD and IO boards speak decades of proprietary industrial protocols. An embodied model cannot reason about the world when every actuator has a different dialect.",
          "The AI-Native HAL flattens them into a single tensor interface: every joint, every drive, every sensor becomes a typed tensor — with safety constraints compiled in as first-class invariants, not runtime checks bolted on later.",
        ],
        zh: [
          "伺服、变频、IO 板卡说着几十年积累下来的私有工业协议。当每个执行器都讲不同方言时，具身模型无法真正理解世界。",
          "AI 原生 HAL 把它们摊平成一张张量接口：每个关节、每个驱动、每个传感器都变成一个类型化的张量——安全约束作为一等不变量直接编译进去，而非事后附加的运行时检查。",
        ],
      },
      points: {
        en: ["Single tensor contract across actuators", "Safety invariants compiled in, not bolted on"],
        zh: ["跨执行器的统一张量契约", "安全不变量被编译进接口，而非事后附加"],
      },
    },
    {
      no: "02",
      title: { en: "The Closed-Loop World Model", zh: "全链路闭环世界模型" },
      slogan: { en: "The world talks back — error is an input", zh: "世界会回响——误差即输入" },
      body: {
        en: [
          "Classic perception feeds the model the world; it never tells the model what its own actions actually did. So every step restarts from zero uncertainty.",
          "We tokenise external perception, body proprioception and control-feedback error into one continuous input stream. The model learns in the loop: what I intended, what I did, what the world returned.",
        ],
        zh: [
          "传统感知只把世界喂给模型，却从不告诉模型它自己的动作到底产生了什么。于是每一步都从零不确定重新开始。",
          "我们把外部感知、本体感知与控制反馈误差一并 Token 化，汇成一条连续的输入流。模型在闭环中学习：我想做什么、我做了什么、世界回馈了什么。",
        ],
      },
      points: {
        en: ["Perception + proprioception + error, all tokenised", "Self-correcting inference inside the loop"],
        zh: ["感知 + 本体 + 误差，全部 Token 化", "在闭环内部自校正的推理"],
      },
    },
    {
      no: "03",
      title: { en: "One Brain, Many Bodies", zh: "一脑多体" },
      slogan: { en: "Run-time adaptive weights", zh: "运行期动态权重适配" },
      body: {
        en: [
          "A car, a quadruped, a humanoid and a drone share kinematic reality but not morphology. Re-training per body is slow and brittle.",
          "Through MoE, hyper-networks and adapters, one base model switches its effective weights at run time from the hardware descriptor it sees. The same brain pilots any body — because the controllers already know the physics; they only need to know the shape.",
        ],
        zh: [
          "车、四足、人形与无人机共享同样的运动学现实，却形态各异。为每种躯体单独重训，既慢又脆。",
          "借助 MoE、超网络与 Adapter，同一个基础模型在运行时根据它所看到的硬件描述，动态切换有效权重。同一颗大脑驾驭任意躯体——因为控制器本已通晓物理，只需知道形态。",
        ],
      },
      points: {
        en: ["MoE / hyper-network / adapter switching", "One base model, every mechanical form"],
        zh: ["MoE / 超网络 / Adapter 动态切换", "一个基础模型，覆盖所有机械形态"],
      },
    },
  ] as Chapter[],
  cta: {
    en: [
      "This is where the compiler meets the body. Explore how we analyse, compile and deploy against every surface.",
      "Back to the homepage",
    ],
    zh: [
      "这就是编译器与躯体相遇的地方。去看看我们如何面向每一个表面做分析、编译与部署。",
      "返回首页",
    ],
  },
};
---

<Layout title="Vision | DYNPHI" description="DYNPHI technical vision — AI-native hardware abstraction, a closed-loop world model, and one brain for many bodies.">
  <Navbar />

  <!-- Header -->
  <section class="grid-scrim relative px-6 py-28 text-center">
    <div class="landing-layout mx-auto flex max-w-4xl flex-col items-center">
      <p
        class="breathing-badge inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.02] px-5 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-cyan-400"
        data-en={vision.eyebrow.en}
        data-zh={vision.eyebrow.zh}
        data-i18n="v-eyebrow"
      >
        <span class="inline-block size-1.5 rounded-full bg-cyan-400" aria-hidden="true"></span>
        {vision.eyebrow.en}
      </p>
      <h1
        class="mt-8 text-4xl font-extrabold tracking-tight text-white sm:text-6xl"
        data-en={vision.title.en}
        data-zh={vision.title.zh}
        data-i18n="v-title"
      >
        {vision.title.en}
      </h1>
      <p
        class="mt-6 text-xl font-medium tracking-tight text-cyan-300"
        data-en={vision.tagline.en}
        data-zh={vision.tagline.zh}
        data-i18n="v-tagline"
      >
        {vision.tagline.en}
      </p>
      <p
        class="mt-8 max-w-2xl text-base leading-relaxed text-zinc-400"
        data-en={vision.intro.en.join(" ")}
        data-zh={vision.intro.zh.join(" ")}
        data-i18n="v-intro"
      >
        {vision.intro.en.join(" ")}
      </p>
    </div>
  </section>

  <!-- Architecture overview -->
  <section id="arch" class="scroll-mt-24 px-6 pb-28">
    <div class="landing-layout">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400"
          data-en={vision.archTitle.en}
          data-zh={vision.archTitle.zh}
          data-i18n="v-arch-title"
        >
          {vision.archTitle.en}
        </p>
        <h2
          class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl"
          data-en={vision.archLegend.en}
          data-zh={vision.archLegend.zh}
          data-i18n="v-arch-legend"
        >
          {vision.archLegend.en}
        </h2>
      </div>

      <!-- Architecture diagram (pure HTML/Tailwind, zero-dependency) -->
      <div class="reveal mt-16 rounded-2xl border border-white/5 bg-white/[0.02] p-6 sm:p-10">
        <!-- Input stream -->
        <div class="grid gap-3 text-center sm:grid-cols-3">
          {["External Perception", "Body Proprioception", "Control Error"].map((s, i) => (
            <div class="rounded-xl border border-white/5 bg-[#0c0c0f] px-4 py-4">
              <p class="font-mono text-[11px] uppercase tracking-widest text-zinc-500">input</p>
              <p class="mt-1 text-sm font-medium text-zinc-200">{s}</p>
            </div>
          ))}
        </div>

        <!-- Arrow down -->
        <div class="my-3 flex justify-center text-cyan-400/70" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m0 0l-6-6m6 6l6-6" /></svg>
        </div>

        <!-- Model core -->
        <div class="rounded-xl border border-cyan-400/25 bg-cyan-400/[0.04] px-4 py-5 text-center">
          <p class="font-mono text-[11px] uppercase tracking-widest text-cyan-400/80">tokenised stream → base model</p>
          <p class="mt-1 text-sm font-semibold text-white">One Brain · MoE / Hyper-network / Adapter</p>
          <p class="mt-1 font-mono text-[11px] text-zinc-500">run-time weights selected from the hardware descriptor</p>
        </div>

        <!-- Arrow down -->
        <div class="my-3 flex justify-center text-cyan-400/70" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m0 0l-6-6m6 6l6-6" /></svg>
        </div>

        <!-- HAL -->
        <div class="rounded-xl border border-white/5 bg-[#0c0c0f] px-4 py-4 text-center">
          <p class="font-mono text-[11px] uppercase tracking-widest text-emerald-400/80">ai-native hal</p>
          <p class="mt-1 text-sm font-medium text-zinc-200">Tensor interface · safety invariants compiled in</p>
        </div>

        <!-- Arrow down -->
        <div class="my-3 flex justify-center text-cyan-400/70" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m0 0l-6-6m6 6l6-6" /></svg>
        </div>

        <!-- Bodies -->
        <div class="grid gap-3 text-center sm:grid-cols-4">
          {["Car", "Quadruped", "Humanoid", "Drone"].map(s => (
            <div class="rounded-xl border border-white/5 bg-white/[0.02] px-4 py-4">
              <p class="text-sm font-medium text-zinc-200">{s}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Three chapters -->
  <section id="pillars" class="px-6 pb-28">
    <div class="landing-layout flex flex-col gap-20">
      {vision.chapters.map((ch, ci) => (
        <article
          class="reveal grid items-start gap-10 md:grid-cols-2 md:gap-14"
        >
          <!-- Left: text -->
          <div class={ci % 2 === 1 ? "md:order-2" : ""}>
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-5xl font-extrabold tracking-tight text-cyan-400/30">{ch.no}</span>
              <div>
                <h2
                  class="text-2xl font-bold tracking-tight text-white sm:text-3xl"
                  data-en={ch.title.en}
                  data-zh={ch.title.zh}
                  data-i18n={`v-ch-t-${ci}`}
                >
                  {ch.title.en}
                </h2>
                <p
                  class="mt-1 text-sm font-medium text-cyan-300"
                  data-en={ch.slogan.en}
                  data-zh={ch.slogan.zh}
                  data-i18n={`v-ch-s-${ci}`}
                >
                  {ch.slogan.en}
                </p>
              </div>
            </div>
            <div class="mt-5 space-y-3">
              {ch.body.en.map((p, pi) => (
                <p
                  class="text-base leading-relaxed text-zinc-400"
                  data-en={ch.body.en[pi]}
                  data-zh={ch.body.zh[pi]}
                  data-i18n={`v-ch-b-${ci}-${pi}`}
                >
                  {p}
                </p>
              ))}
            </div>
            <ul class="mt-6 space-y-2.5">
              {ch.points.en.map((pt, pi) => (
                <li class="flex items-start gap-2.5 text-sm text-zinc-300">
                  <span class="mt-0.5 inline-flex size-5 flex-none items-center justify-center rounded-full bg-emerald-400/10 text-emerald-400" aria-hidden="true">✓</span>
                  <span data-en={ch.points.en[pi]} data-zh={ch.points.zh[pi]} data-i18n={`v-ch-p-${ci}-${pi}`}>
                    {ch.points.en[pi]}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Right: mini schematic (per-chapter, zero-dep) -->
          <div class={ci % 2 === 1 ? "md:order-1" : ""}>
            <div class="rounded-xl border border-white/5 bg-[#0c0c0f] p-6 font-mono text-[13px] leading-relaxed text-zinc-300">
              {ci === 0 && (
                <>
                  <p class="mb-3 text-[11px] uppercase tracking-widest text-zinc-500">// ai-native hal</p>
                  <p class="whitespace-pre">type Actuator &#123;</p>
                  <p class="whitespace-pre text-zinc-400">  servo :: Tensor&lt;3&gt;</p>
                  <p class="whitespace-pre text-zinc-400">  vfd   :: Tensor&lt;3&gt;</p>
                  <p class="whitespace-pre text-zinc-400">  io    :: Tensor&lt;N&gt;</p>
                  <p class="whitespace-pre">&#125;</p>
                  <p class="mt-3 whitespace-pre text-cyan-300/80">compile(safety_invariants)</p>
                </>
              )}
              {ci === 1 && (
                <>
                  <p class="mb-3 text-[11px] uppercase tracking-widest text-zinc-500">// closed-loop world model</p>
                  <p class="whitespace-pre">state = [</p>
                  <p class="whitespace-pre text-zinc-400">  perception,       // the world</p>
                  <p class="whitespace-pre text-zinc-400">  proprioception,   // the body</p>
                  <p class="whitespace-pre text-zinc-400">  error,            // what came back</p>
                  <p class="whitespace-pre">].toStream()</p>
                  <p class="mt-3 whitespace-pre text-cyan-300/80">model(state).self_correct()</p>
                </>
              )}
              {ci === 2 && (
                <>
                  <p class="mb-3 text-[11px] uppercase tracking-widest text-zinc-500">// one brain, many bodies</p>
                  <p class="whitespace-pre">weights = moe(</p>
                  <p class="whitespace-pre text-zinc-400">  hw_descriptor,     // car | dog</p>
                  <p class="whitespace-pre text-zinc-400">                     // humanoid | drone</p>
                  <p class="whitespace-pre">)</p>
                  <p class="mt-3 whitespace-pre text-cyan-300/80">base.move(weights)</p>
                </>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 pb-32">
    <div class="landing-layout mx-auto max-w-2xl text-center">
      <p
        class="text-base leading-relaxed text-zinc-400"
        data-en={vision.cta.en[0]}
        data-zh={vision.cta.zh[0]}
        data-i18n="v-cta"
      >
        {vision.cta.en[0]}
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-lg bg-cyan-400 px-8 py-3.5 text-base font-semibold text-[#06202a] transition-all duration-200 motion-ease hover:-translate-y-0.5 hover:bg-cyan-300"
        data-en={vision.cta.en[1]}
        data-zh={vision.cta.zh[1]}
        data-i18n="v-cta-link"
      >
        {vision.cta.en[1]}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <Footer />

  <script>
    import { initMotion } from "@/scripts/motion";
    initMotion();
  </script>
</Layout>