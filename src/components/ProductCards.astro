---
import config from "@/config";

const { landing, landingZh } = config;

const icons: Record<string, string> = {
  // Code - brackets
  code: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 8l-4 4l4 4"/><path d="M17 8l4 4l-4 4"/><path d="M14 4l-4 16"/></svg>`,
  // Physics - atom orbit
  physics: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M12 9a2 2 0 0 0 -3.5 -1.5a6 6 0 0 0 7 0a2 2 0 0 0 -3.5 1.5"/><path d="M10.5 12a2 2 0 0 0 0 2a6 6 0 0 0 0 -2"/><path d="M13.5 12a2 2 0 0 0 0 2a6 6 0 0 0 0 -2"/><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/></svg>`,
  // Agent - robot / cpu
  agent: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M6 9a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M9 21h6"/><path d="M3 12h18"/><path d="M9 9h6l3 -4"/><path d="M9 9l-3 -4"/><path d="M9 21v-5"/><path d="M15 21v-5"/></svg>`,
};
---

<section id="products" class="border-t border-border">
  <div class="landing-layout py-28">
    <h2
      class="text-3xl font-bold tracking-tight sm:text-4xl"
      data-en={landing.productsTitle}
      data-zh={landingZh.productsTitle}
      data-i18n="products-title"
    >
      {landing.productsTitle}
    </h2>
    <p
      class="mt-3 max-w-2xl text-muted-foreground"
      data-en={landing.productsSubtitle}
      data-zh={landingZh.productsSubtitle}
      data-i18n="products-sub"
    >
      {landing.productsSubtitle}
    </p>
    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      {landing.products.map((product, i) => {
        const zh = landingZh.products[i] ?? product;
        const anchorId =
          product.icon === "code" ? "code-analysis" : product.icon === "physics" ? "physics-ai" : "agent";
        return (
          <a
            href={product.linkHref}
            id={anchorId}
            class="group flex scroll-mt-24 flex-col rounded-2xl border border-border bg-background/70 p-10 shadow-sm transition-all duration-150 hover:-translate-y-1 hover:border-accent/50 hover:shadow-md"
          >
            <div class="flex items-center justify-between">
              <span
                class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-accent-soft text-accent transition-colors duration-150 group-hover:bg-accent group-hover:text-accent-foreground"
                aria-hidden="true"
                set:html={icons[product.icon] ?? icons.code}
              />
              <span class="text-sm font-semibold tracking-widest text-muted-foreground/60">
                {product.index}
              </span>
            </div>
            <h3
              class="mt-8 text-2xl font-bold tracking-tight text-foreground"
              data-en={product.title}
              data-zh={zh.title}
              data-i18n={`product-${i}-title`}
            >
              {product.title}
            </h3>
            <p
              class="mt-3 flex-1 text-base leading-relaxed text-muted-foreground"
              data-en={product.description}
              data-zh={zh.description}
              data-i18n={`product-${i}-desc`}
            >
              {product.description}
            </p>
            <span
              class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent transition-all duration-150 group-hover:gap-3"
              data-en={product.linkLabel}
              data-zh={zh.linkLabel}
              data-i18n={`product-${i}-cta`}
            >
              {product.linkLabel}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>