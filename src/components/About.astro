---
import config from "@/config";

const { landing, landingZh } = config;
---

<section id="about" class="border-t border-border bg-background/60">
  <div class="landing-layout py-28">
    <h2
      class="text-3xl font-bold tracking-tight sm:text-4xl"
      data-en={landing.aboutTitle}
      data-zh={landingZh.aboutTitle}
      data-i18n="about-title"
    >
      {landing.aboutTitle}
    </h2>
    <div class="mt-6 space-y-4">
      {landing.aboutParagraphs.map((p, i) => (
        <p
          class="max-w-3xl leading-relaxed text-muted-foreground"
          data-en={p}
          data-zh={landingZh.aboutParagraphs[i] ?? landingZh.aboutTitle}
          data-i18n={`about-p-${i}`}
        >
          {p}
        </p>
      ))}
    </div>
    <div class="mt-8">
      <a
        href={landing.contactHref}
        class="inline-flex items-center gap-2 text-sm font-medium text-accent underline decoration-dashed underline-offset-4 transition-colors duration-150 hover:opacity-80"
        data-en={landing.contactLabel}
        data-zh={landingZh.contactLabel}
        data-i18n="about-contact"
      >
        {landing.contactLabel}
      </a>
    </div>
  </div>
</section>