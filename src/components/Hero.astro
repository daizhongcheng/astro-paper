---
import config from "@/config";

const { landing, landingZh } = config;
---

<section
  id="main-content"
  class="landing-layout flex min-h-[78svh] flex-col items-center justify-center py-20 text-center"
>
  <h1
    class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight sm:text-6xl"
    data-en={landing.heroTitle}
    data-zh={landingZh.heroTitle}
    data-i18n="hero-title"
  >
    {landing.heroTitle}
  </h1>
  <p
    class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg"
    data-en={landing.heroSubtitle}
    data-zh={landingZh.heroSubtitle}
    data-i18n="hero-sub"
  >
    {landing.heroSubtitle}
  </p>
  <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:gap-4">
    <!-- Primary CTA: GitHub -->
    <a
      href={landing.githubHref}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-md bg-accent px-7 py-3 text-sm font-semibold text-accent-foreground shadow-sm transition-colors duration-150 hover:bg-accent/85"
      data-en={landing.heroCtaPrimary}
      data-zh={landingZh.heroCtaPrimary}
      data-i18n="hero-cta-primary"
    >
      {landing.heroCtaPrimary}
    </a>
    <!-- Secondary CTA: About the project -->
    <a
      href="#overview"
      class="inline-flex items-center justify-center rounded-md border border-border bg-muted/40 px-7 py-3 text-sm font-semibold text-foreground/90 transition-colors duration-150 hover:border-accent/50 hover:text-accent"
      data-en={landing.heroCtaSecondary}
      data-zh={landingZh.heroCtaSecondary}
      data-i18n="hero-cta-secondary"
    >
      {landing.heroCtaSecondary}
    </a>
  </div>
</section>