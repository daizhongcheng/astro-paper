---
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconX from "@/assets/icons/IconX.svg";
import IconGithub from "@/assets/icons/socials/github.svg";
import config from "@/config";

const { landing } = config;

const navLinks = [
  { label: "Overview", href: "#overview" },
  { label: "Products", href: "#products" },
  { label: "Tech Stack", href: "#tech-stack" },
  { label: "About", href: "#about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 transition-all focus:top-4"
>
  Skip to content
</a>

<header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur">
  <nav
    id="navbar"
    class="landing-layout flex items-center justify-between py-4"
    aria-label="Main navigation"
  >
    <a href="#main-content" class="text-xl font-bold tracking-tight">
      {landing.brand}
    </a>

    <!-- Mobile hamburger -->
    <button
      id="navbar-toggle"
      class="focus-outline inline-flex items-center justify-center p-1 sm:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="navbar-menu"
    >
      <IconMenuDeep id="navbar-open" width={24} height={24} class="stroke-foreground" />
      <IconX id="navbar-close" width={24} height={24} class="stroke-foreground hidden" />
    </button>

    <ul
      id="navbar-menu"
      class="hidden w-full flex-col gap-1 py-4 sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-7 sm:py-0"
    >
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="block rounded px-1 py-2 text-sm font-medium text-foreground/80 transition-colors duration-150 hover:text-accent sm:py-0"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="sm:ms-1">
        <a
          href={landing.githubHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub repository"
          title="GitHub"
          class="inline-flex items-center gap-1.5 p-1 text-foreground/80 transition-colors duration-150 hover:text-accent"
        >
          <IconGithub width={22} height={22} class="stroke-foreground" />
          <span class="sr-only">GitHub</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  function bindToggle() {
    const btn = document.getElementById("navbar-toggle");
    const menu = document.getElementById("navbar-menu");
    const openIcon = document.getElementById("navbar-open");
    const closeIcon = document.getElementById("navbar-close");
    if (!btn || !menu || !openIcon || !closeIcon) return;

    const toggle = () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      const next = !open;
      btn.setAttribute("aria-expanded", String(next));
      menu.classList.toggle("hidden", !next);
      menu.classList.toggle("flex", next);
      openIcon.classList.toggle("hidden", next);
      closeIcon.classList.toggle("hidden", !next);
    };

    btn.addEventListener("click", toggle);
    // Reset menu on navigation to avoid stale expanded state.
    menu.querySelectorAll("a").forEach(a => a.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      if (open) {
        btn.setAttribute("aria-expanded", "false");
        menu.classList.add("hidden");
        menu.classList.remove("flex");
        openIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      }
    }));
  }

  bindToggle();
  document.addEventListener("astro:after-swap", bindToggle);
</script>