---
import config from "@/config";

const { landing } = config;
---

<section id="overview" class="border-t border-border bg-background/60">
  <div class="landing-layout py-20">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
      {landing.overviewTitle}
    </h2>
    <div class="mt-6 space-y-4">
      {landing.overviewParagraphs.map(p => (
        <p class="max-w-3xl leading-relaxed text-muted-foreground">{p}</p>
      ))}
    </div>
  </div>
</section>