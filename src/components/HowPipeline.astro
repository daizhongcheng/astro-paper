---
import config from "@/config";

const { landing, landingZh } = config;
const steps = landing.howSteps;
const stepsZh = landingZh.howSteps;
---

<section id="how" class="scroll-mt-24 px-6 py-28">
  <div class="landing-layout">
    <!-- headline -->
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400"
        data-en={landing.howTitle}
        data-zh={landingZh.howTitle}
        data-i18n="how-no"
      >
        {landing.howTitle}
      </p>
      <h2
        class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl"
        data-en={landing.howSubtitle}
        data-zh={landingZh.howSubtitle}
        data-i18n="how-headline"
      >
        {landing.howSubtitle}
      </h2>
    </div>

    <!-- Vertical pipeline -->
    <div class="reveal relative mx-auto mt-20 max-w-2xl">
      <!-- connector line -->
      <div
        class="absolute bottom-6 left-6 top-4 w-px bg-gradient-to-b from-cyan-400/50 via-white/15 to-transparent"
        aria-hidden="true"
      ></div>

      <ol class="relative space-y-12">
        {steps.map((step, i) => {
          const zh = stepsZh[i] ?? step;
          return (
            <li class="relative flex gap-6">
              <div class="relative flex-none">
                <span
                  class="flex size-12 items-center justify-center rounded-xl border border-cyan-400/25 bg-[#0c0c0f] font-mono text-sm font-bold text-cyan-400 shadow-[0_0_22px_rgba(34,211,238,0.12)]"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <div class="pt-1">
                <h3
                  class="text-lg font-semibold text-white"
                  data-en={step.title}
                  data-zh={zh.title}
                  data-i18n={`how-step-title-${i}`}
                >
                  {step.title}
                </h3>
                <p
                  class="mt-1.5 max-w-md text-sm leading-relaxed text-zinc-400"
                  data-en={step.desc}
                  data-zh={zh.desc}
                  data-i18n={`how-step-desc-${i}`}
                >
                  {step.desc}
                </p>
              </div>
            </li>
          );
        })}
      </ol>

      <div class="mt-16 text-center">
        <a
          href="/vision"
          class="group inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.02] px-7 py-3.5 text-sm font-semibold text-zinc-200 transition-all duration-200 motion-ease hover:-translate-y-0.5 hover:border-cyan-400/40 hover:text-cyan-300"
        >
          <span
            data-en="Read the technical vision — one brain, many bodies"
            data-zh="阅读技术愿景——一脑多体"
            data-i18n="how-vision-link"
            >Read the technical vision — one brain, many bodies</span
          >
          <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </div>
  </div>
</section>