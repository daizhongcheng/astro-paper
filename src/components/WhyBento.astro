---
import config from "@/config";

const { landing, landingZh } = config;
---

<section id="why" class="scroll-mt-24 px-6 pt-12 pb-28">
  <div class="landing-layout">
    <!-- Section headline -->
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400"
        data-en={landing.whyTitle}
        data-zh={landingZh.whyTitle}
        data-i18n="why-no"
      >
        {landing.whyTitle}
      </p>
      <h2
        class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl"
        data-en={landing.whySubtitle}
        data-zh={landingZh.whySubtitle}
        data-i18n="why-headline"
      >
        {landing.whySubtitle}
      </h2>
    </div>

    <!-- Bento grid -->
    <div class="reveal mt-16 grid grid-cols-1 gap-4 md:grid-cols-3 md:auto-rows-[200px]">
      <!-- Dilemma card -->
      <div class="spotlight-card flex flex-col rounded-xl border border-white/5 bg-white/[0.02] p-6 md:col-span-2 md:row-span-2">
        <div>
          <h3
            class="text-lg font-semibold text-white"
            data-en={landing.whyDilemmaTitle}
            data-zh={landingZh.whyDilemmaTitle}
            data-i18n="why-dilemma-title"
          >
            {landing.whyDilemmaTitle}
          </h3>
          <p
            class="mt-2 max-w-md text-sm leading-relaxed text-zinc-400"
            data-en={landing.whyDilemmaDesc}
            data-zh={landingZh.whyDilemmaDesc}
            data-i18n="why-dilemma-desc"
          >
            {landing.whyDilemmaDesc}
          </p>
        </div>
        <div class="mt-5 flex-1 rounded-lg border border-red-500/15 bg-red-500/[0.04] px-4 py-4 font-mono text-[13px] leading-relaxed text-rose-300/90">
          <div class="mb-2 flex items-center gap-2">
            <span class="size-2 rounded-full bg-rose-400/70"></span>
            <span class="text-[11px] uppercase tracking-wider text-rose-300/50">unchecked</span>
          </div>
          {landing.whyDilemmaCode.split("\n").map(l => (
            <div class="whitespace-pre">{l}</div>
          ))}
        </div>
      </div>

      <!-- Constraint card -->
      <div class="spotlight-card flex flex-col rounded-xl border border-white/5 bg-white/[0.02] p-6 md:row-span-3">
        <div>
          <h3
            class="text-lg font-semibold text-white"
            data-en={landing.whyConstraintTitle}
            data-zh={landingZh.whyConstraintTitle}
            data-i18n="why-constraint-title"
          >
            {landing.whyConstraintTitle}
          </h3>
          <p
            class="mt-2 text-sm leading-relaxed text-zinc-400"
            data-en={landing.whyConstraintDesc}
            data-zh={landingZh.whyConstraintDesc}
            data-i18n="why-constraint-desc"
          >
            {landing.whyConstraintDesc}
          </p>
        </div>
        <ul class="mt-5 space-y-3">
          {landing.whyConstraintPoints.map((pt, i) => (
            <li class="flex items-start gap-2.5 text-sm text-zinc-300">
              <span
                class="mt-0.5 inline-flex size-5 flex-none items-center justify-center rounded-full bg-emerald-400/10 text-emerald-400"
                aria-hidden="true"
              >
                ✓
              </span>
              <span data-en={pt} data-zh={landingZh.whyConstraintPoints[i] ?? pt} data-i18n={`why-pt-${i}`}>
                {pt}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Metric 1 -->
      <div class="spotlight-card flex flex-col justify-between rounded-xl border border-white/5 bg-white/[0.02] p-6">
        <p
          class="text-xs font-medium uppercase tracking-widest text-zinc-500"
          data-en={landing.whyMetric1Label}
          data-zh={landingZh.whyMetric1Label}
          data-i18n="why-m1-label"
        >
          {landing.whyMetric1Label}
        </p>
        <div class="mt-3">
          <div class="flex items-center gap-1">
            <span
              class="token-value text-5xl font-extrabold tracking-tight text-cyan-400"
              data-ticker="true"
              data-target={landing.whyMetric1Value}
              data-decimals="1"
              data-suffix="%"
              >0.0%</span
            >
          </div>
          <p
            class="mt-1 text-xs text-zinc-500"
            data-en={landing.whyMetric1Caption}
            data-zh={landingZh.whyMetric1Caption}
            data-i18n="why-m1-cap"
          >
            {landing.whyMetric1Caption}
          </p>
        </div>
      </div>

      <!-- Metric 2 -->
      <div class="spotlight-card flex flex-col justify-between rounded-xl border border-white/5 bg-white/[0.02] p-6">
        <p
          class="text-xs font-medium uppercase tracking-widest text-zinc-500"
          data-en={landing.whyMetric2Label}
          data-zh={landingZh.whyMetric2Label}
          data-i18n="why-m2-label"
        >
          {landing.whyMetric2Label}
        </p>
        <div class="mt-3">
          <div class="flex items-baseline gap-1">
            <span
              class="token-value text-5xl font-extrabold tracking-tight text-cyan-400"
              data-ticker="true"
              data-target={landing.whyMetric2Value}
              data-decimals="0"
              data-suffix="ms"
              >0ms</span
            >
          </div>
          <p
            class="mt-1 text-xs text-zinc-500"
            data-en={landing.whyMetric2Caption}
            data-zh={landingZh.whyMetric2Caption}
            data-i18n="why-m2-cap"
          >
            {landing.whyMetric2Caption}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>