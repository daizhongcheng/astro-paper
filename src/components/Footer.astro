---
import IconGithub from "@/assets/icons/socials/github.svg";
import IconX from "@/assets/icons/socials/x.svg";
import IconMail from "@/assets/icons/socials/mail.svg";
import config from "@/config";

const { landing, site, socials } = config;
const currentYear = new Date().getFullYear();

const socialIcons = [
  { icon: IconGithub, label: "GitHub", href: socials.find(s => s.name === "github")?.url ?? "" },
  { icon: IconX, label: "X", href: socials.find(s => s.name === "x")?.url ?? "" },
  { icon: IconMail, label: "Email", href: socials.find(s => s.name === "mail")?.url ?? "" },
];
---

<footer class="mt-0 border-t border-border">
  <div class="landing-layout flex flex-col items-center justify-between gap-4 py-8 sm:flex-row">
    <div class="flex flex-col items-center gap-1 sm:items-start">
      <span class="text-sm font-medium text-foreground/60">
        {landing.brand} &#169; {currentYear} {site.title}
      </span>
      <span class="text-xs text-muted-foreground">{landing.footerTagline}</span>
    </div>
    <div class="flex items-center gap-4">
      {socialIcons.map(s => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          title={s.label}
          class="text-muted-foreground transition-colors duration-150 hover:text-accent"
        >
          <s.icon width={20} height={20} />
        </a>
      ))}
    </div>
  </div>
</footer>